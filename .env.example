# Docker Compose infrastructure. Copy to .env in the repository root.
# Local development only. Replace placeholder passwords before deployment.

# PostgreSQL
POSTGRES_USER=imageboard
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=imageboard
DB_HOST=127.0.0.1
DB_PORT=5432

# pgAdmin
PGADMIN_HOST=127.0.0.1
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password

# MinIO server
MINIO_HOST=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=imageboard
MINIO_ROOT_PASSWORD=change-me-minio-password
