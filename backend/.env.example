# Backend API. Copy to .env in this directory.
# Database and MinIO credentials must match the root .env.
# Hosts and ports point to services accessible from the backend.

# Express API (matches the frontend API URL)
PORT=8080

# PostgreSQL connection
POSTGRES_USER=imageboard
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=imageboard
DB_HOST=127.0.0.1
DB_PORT=5432

# MinIO client
MINIO_HOST=127.0.0.1
MINIO_API_PORT=9000
MINIO_ROOT_USER=imageboard
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET_NAME=imageboard
STORAGE_USE_SSL=false

# Poster IP hashing: replace with a long random secret.
# Generate one with: openssl rand -hex 32
HASH_SECRET=change-me-use-a-long-random-secret

DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=5433
POSTGRES_TEST_DB=app_test